# ==== Server ====
PORT=8000
ENV=production

# ==== Crypto (must match the Android app's implementation) ====
# 32-byte AES key, base64-encoded. Generate with: openssl rand -base64 32
AES_KEY_B64=REPLACE_ME_32_BYTE_BASE64_KEY
# HMAC signing secret shared with the app (random 64+ char string)
HMAC_SECRET=REPLACE_ME_LONG_RANDOM_SECRET
# Max allowed clock drift (seconds) between app timestamp and server time (anti-replay window)
REQUEST_TTL_SECONDS=90

# ==== APK attestation ====
# SHA-256 of your release signing certificate, lowercase hex, no colons.
# Get it with: keytool -exportcert -alias <key_alias> -keystore <your.keystore> | openssl sha256
EXPECTED_APK_CERT_SHA256=REPLACE_ME
# Comma-separated list of allowed app package names (defense in depth)
ALLOWED_PACKAGE_NAMES=com.drdev.hamza

# ==== Firebase ====
# Paste the full service-account JSON as a single line, OR set FIREBASE_SERVICE_ACCOUNT_FILE to a path.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_DB_URL=https://your-project-id-default-rtdb.firebaseio.com

# ==== Admin reload ====
# Secret the admin panel sends to force an immediate config reload instead of waiting for the refresh timer
ADMIN_RELOAD_TOKEN=REPLACE_ME
CONFIG_REFRESH_SECONDS=60

# ==== YouTube ====
# Comma-separated list of proxy URLs used ONLY for YouTube extraction, rotated per request.
# Format: http://user:pass@host:port  or  socks5://host:port
YOUTUBE_PROXIES=

# ==== CORS ====
# Your admin panel origin(s), comma separated. The mobile app does not use CORS (it's not a browser).
ADMIN_PANEL_ORIGINS=https://your-admin-panel.example.com
