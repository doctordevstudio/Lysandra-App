PORT=8001
ENV=production

# ==== Firebase (same project as the main backend) ====
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_DB_URL=https://your-project-id-default-rtdb.firebaseio.com

# ==== Admin login (raw credentials -- no hashing, no Firebase-stored account) ====
ADMIN_USERNAME=REPLACE_ME
ADMIN_PASSWORD=REPLACE_ME_WITH_SOMETHING_LONG_AND_RANDOM

# ==== Sessions ====
SESSION_SECRET=REPLACE_ME_LONG_RANDOM_STRING
SESSION_TTL_MINUTES=15
LOCKOUT_MAX_ATTEMPTS=3
LOCKOUT_DURATION_HOURS=24
# Set true only if serving over HTTPS (Render gives you this by default) -- cookies won't be sent otherwise.
COOKIE_SECURE=true

# ==== Cross-service call to the main backend after a settings save ====
MAIN_BACKEND_RELOAD_URL=https://lysandraapp.onrender.com/internal/reload-config
MAIN_BACKEND_ADMIN_TOKEN=REPLACE_ME_SAME_AS_ADMIN_RELOAD_TOKEN_ON_MAIN_BACKEND
