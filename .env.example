# ---- copy to .env for local runs; on Render add these in Dashboard > Environment ----
# Firebase Realtime Database (rules: read/write true). Only the SERVER knows this URL.
FIREBASE_DB_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
# optional legacy database secret if you ever lock the rules
FIREBASE_DB_SECRET=

# Shared secret with the Android app. Generate with:  python tools/gen_secrets.py
APP_SECRET=
# SHA-256 of your release signing certificate (lowercase hex, comma separated for several). Empty = not enforced.
ALLOWED_APK_SHA256=

ADMIN_USER=admin
ADMIN_PASSWORD=change-this-long-password
ADMIN_PATH=/lysandra-admin

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=use-letters-numbers-underscore-only
PUBLIC_URL=https://lysandraapp.onrender.com

# Cloudflare "Transform Rule" adds this header to every request; requests without it are rejected (403)
ORIGIN_SECRET=
TRUST_CLOUDFLARE=1

# comma separated proxies for YouTube e.g. http://user:pass@host:port
YOUTUBE_PROXIES=
YT_COOKIES=
TERABOX_API_URL=
# none | ipapi_is  (free tier datacenter / VPN / proxy lookup, cached 24h)
IPINTEL_PROVIDER=ipapi_is
